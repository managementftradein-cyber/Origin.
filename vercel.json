{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/sermons",
      "destination": "/api/content?type=sermons"
    },
    {
      "source": "/api/events",
      "destination": "/api/content?type=events"
    },
    {
      "source": "/api/departments",
      "destination": "/api/content?type=departments"
    },
    {
      "source": "/api/photos",
      "destination": "/api/content?type=photos"
    },
    {
      "source": "/api/news",
      "destination": "/api/content?type=news"
    },
    {
      "source": "/api/prophetic-words",
      "destination": "/api/content?type=prophetic-words"
    },
    {
      "source": "/api/giving",
      "destination": "/api/content?type=giving"
    },
    {
      "source": "/api/site-content",
      "destination": "/api/content?type=site-content"
    },
    {
      "source": "/api/contact",
      "destination": "/api/forms?type=contact"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/forms?type=subscribe"
    },
    {
      "source": "/api/prayer-requests",
      "destination": "/api/forms?type=prayer-requests"
    },
    {
      "source": "/api/health",
      "destination": "/api/system?type=health"
    },
    {
      "source": "/api/config",
      "destination": "/api/system?type=config"
    },
    {
      "source": "/api/auth-status",
      "destination": "/api/system?type=auth-status"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dept-admin",
      "destination": "/dept-admin/index.html"
    },
    {
      "source": "/dept-admin/",
      "destination": "/dept-admin/index.html"
    },
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/programs",
      "destination": "/"
    },
    {
      "source": "/partnership",
      "destination": "/"
    },
    {
      "source": "/college",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/give",
      "destination": "/"
    },
    {
      "source": "/find-us",
      "destination": "/"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/prophetic-room",
      "destination": "/prophetic-room.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-backup",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://js.paystack.co https://www.youtube.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.paystack.co; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://player.vimeo.com https://checkout.paystack.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/dept-admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/dept-admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/pwa/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
